# dependencies
node_modules/

# render / build outputs (large binaries: frames, mp4s, wavs)
build/
out/
*.mp4
*.wav
*.part

# run logs — transient, and one per pipeline run
projects/*.log
*.log

# python bytecode
__pycache__/
*.pyc

# OS junk
.DS_Store
Thumbs.db

# generated project outputs — rebuilt by director.py + render.mjs, never authored.
# Only the approved reference film stays tracked (its style-lock is a record).
projects/*/
!projects/cine_release/

# scratch
tmp/
